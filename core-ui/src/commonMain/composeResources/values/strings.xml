    <string name="changelog_fixed">Fixed</string>
    <string name="changelog_011_profiles">Names and avatars update without reopening the chat. Previously outdated profiles are refreshed.</string>
    <string name="changelog_011_groups">Group members, roles and read receipts update live on open screens.</string>
    <string name="changelog_011_limits">Server rate limits pause requests without disconnecting the chat or losing queued messages.</string>
    <string name="changelog_011_keyboard">Fixed the message input position when opening the Android keyboard.</string>
    <string name="changelog_011_admin">Server administration requests an authenticator code when needed and retries the confirmed action.</string>
    <string name="changelog_011_about">Added release history and a library license viewer in About.</string>
    <string name="changelog_initial_release">First release</string>
    <string name="changelog_010_chats">Personal and group chats, replies, editing and deleting messages.</string>
    <string name="changelog_010_attachments">Photos, videos, audio and documents with attachment viewers.</string>
    <string name="changelog_010_offline">Saved chat history, drafts and queued messages while offline.</string>
    <string name="changelog_010_connection">Automatic reconnection, unread message indicators and read receipts.</string>
    <string name="changelog_010_account">Email sign-in, profile settings and group management.</string>
    <string name="third_party_licenses">Libraries and licenses</string>
