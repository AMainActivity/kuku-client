    <string name="changelog_012_sound">Added the Kuku! notification sound on Android, with system sound and silent options.</string>
    <string name="changelog_012_unban">Find users and bots to remove their group ban.</string>
    <string name="changelog_012_statuses">Message statuses appear as icons next to the time. Tap the error icon to retry sending.</string>
    <string name="changelog_012_notifications">Open chats stay quiet; message bursts trigger at most one sound every five seconds.</string>
    <string name="changelog_012_startup">Startup restores the local session before opening chats or sign-in, with retry on storage errors and no network wait.</string>
    <string name="changelog_012_history">Fixed offline history display and positioning at unread messages. Delayed responses preserve your reading position.</string>
    <string name="changelog_012_cache">Outdated responses no longer roll back chat data or restore chats after access is revoked.</string>
    <string name="changelog_012_files">Fixed retries for damaged downloads and access to forwarded attachments; limited download response buffering.</string>
    <string name="changelog_012_text">The server text size limit is checked before clearing the message input.</string>
    <string name="changelog_012_email">Fixed authenticator code entry when changing email. Notifications are cleared after logout or loss of chat access.</string>
